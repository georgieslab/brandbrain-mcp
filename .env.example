# AWS Bedrock Authentication
# Standard AWS credentials used by boto3 to call Bedrock Converse and Titan Embeddings
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# Bedrock Model Identifiers
# Moonshot AI Kimi K3 Converse Model:
BEDROCK_MODEL_ID=moonshotai.kimi-k3
# Default Titan Embeddings V2 Model:
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Vector Database Configuration
CHROMA_PERSIST_DIR=./data/chroma_db

# Fallback Mode
# Set to 'true' to seamlessly fallback to local embeddings if AWS credentials lack Titan access
EMBEDDING_FALLBACK_LOCAL=true
